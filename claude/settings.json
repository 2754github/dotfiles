{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 10,
  "env": {
    "CLAUDE_AFK_TIMEOUT_MS": "86400000",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_USER_DIALOG_TIMEOUT_MS": "0",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_MICROCOMPACT": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(gh issue view *)",
      "Bash(gh pr create -d -a @me *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr view *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git mv *)",
      "Bash(npm audit *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "ExitPlanMode",
      "Skill",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(chmod *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(nc *)",
      "Bash(wget *)",
      "Bash(gh repo *)",
      "Bash(git clone *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git -C *)",
      "Bash(npx *)",
      "Read(~/.ssh/**)",
      "Read(.env*)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay $HOME/dotfiles/claude/hooks/Notification.mp3"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay $HOME/dotfiles/claude/hooks/Stop.mp3"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay $HOME/dotfiles/claude/hooks/SubagentStop.mp3"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/dotfiles/claude/statusLine"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true
  },
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh/**",
        ".env*"
      ]
    },
    "excludedCommands": [
      "gh *"
    ]
  },
  "spinnerTipsEnabled": false,
  "autoMemoryEnabled": false,
  "showThinkingSummaries": true,
  "theme": "light",
  "autoCompactEnabled": false,
  "autoScrollEnabled": false,
  "terminalProgressBarEnabled": false,
  "skipAutoPermissionPrompt": true
}
